{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "maven-r2",
    "main": "src/index.ts",
    "compatibility_date": "2026-09-19",
    "compatibility_flags": ["nodejs_compat"],
    "observability": { "enabled": true },
    "limits": { "cpu_ms": 300000 },
    "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "html_handling": "none",
        "run_worker_first": true,
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "maven-r2",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "migrations",
        },
    ],
    "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "maven-r2" }],
    "durable_objects": {
        "bindings": [{ "name": "REPOSITORIES", "class_name": "RepositoryCoordinator" }],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RepositoryCoordinator"] }],
    "triggers": { "crons": ["17 * * * *"] },
    "vars": {
        "APP_URL": "http://localhost:5173",
        "REPOSITORY_MAPPINGS": [],
        "INSTANCE_MODE": "single",
        "SIGNUP_MODE": "closed",
        "ALLOW_ACCOUNT_CREATION": "false",
        "DEFAULT_ACCOUNT_SLUG": "default",
        "DEFAULT_ACCOUNT_NAME": "My repository",
        "ADMIN_GITHUB_IDS": "",
        "MAX_FILE_BYTES": "2147483648",
        "MAX_ACCOUNT_BYTES": "10737418240",
    },
}
