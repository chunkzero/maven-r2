<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example.mavenr2</groupId>
    <artifactId>maven-example</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>Maven R2 example</name>
    <properties>
        <revision>1.0.0</revision>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <modules><module>library</module></modules>
    <distributionManagement>
        <repository><id>maven-r2</id><url>${env.MAVEN_R2_URL}</url></repository>
        <snapshotRepository><id>maven-r2</id><url>${env.MAVEN_R2_URL}</url></snapshotRepository>
    </distributionManagement>
    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-deploy-plugin</artifactId><version>3.1.4</version></plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>flatten-maven-plugin</artifactId><version>1.7.3</version>
                <configuration><updatePomFile>true</updatePomFile><flattenMode>resolveCiFriendliesOnly</flattenMode></configuration>
                <executions><execution><id>flatten</id><phase>process-resources</phase><goals><goal>flatten</goal></goals></execution></executions>
            </plugin>
        </plugins>
    </build>
</project>
