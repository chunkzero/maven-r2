{
    "name": "maven-r2",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "pnpm --parallel --filter './apps/*' dev",
        "format": "vp fmt",
        "format:check": "vp fmt --check",
        "lint": "vp lint",
        "typecheck": "pnpm -r typecheck",
        "build": "pnpm --filter @maven-r2/web build && pnpm --filter @maven-r2/worker build",
        "contracts": "pnpm --filter @maven-r2/contracts generate",
        "test:worker": "pnpm --filter @maven-r2/worker test",
        "db:migrate": "pnpm --filter @maven-r2/worker db:migrate"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@types/node": "^24.0.0",
        "tsx": "^4.20.0",
        "typescript": "^5.9.0",
        "vite-plus": "0.3.3"
    },
    "packageManager": "pnpm@10.33.0"
}
